---
/**
 * One live demo, embedded from the wasm catalog at /catalog/?id=…
 *
 * Deliberately an iframe rather than an in-page Compose root: every Compose root holds its own
 * WebGL2 context, browsers cap those (~8 on Android) and Compose exposes no dispose API, so
 * per-demo canvases would break a long page. `loading="lazy"` keeps the runtime off the initial
 * load; the browser fetches it when the frame nears the viewport, and it is HTTP- and V8-cached
 * for every later demo in the session.
 *
 * The idiom and light/dark controls live inside the frame, so switching is a recomposition rather
 * than an iframe reload. `idiom` and `mode` here only seed them.
 */
interface Props {
  id: string;
  idiom?: 'android' | 'apple' | 'desktop';
  mode?: 'light' | 'dark' | 'system';
  height?: number;
  caption?: string;
}
const { id, idiom, mode, height = 260, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const params = new URLSearchParams({ id, ...(idiom ? { idiom } : {}), ...(mode ? { mode } : {}) });
---
<figure class="ditto-demo">
  {/* The frame rounds the iframe. Its border is drawn as an ::after overlay in brand.css: a real
      CSS border sits *under* the iframe's opaque background, which eats the inner edge along the
      curve and makes the corners look clipped. */}
  <div class="ditto-demo-frame" style={`height:${height}px`}>
    <iframe
      loading="lazy"
      src={`${base}/catalog/?${params.toString()}`}
      title={caption ?? `${id} demo`}
    ></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
