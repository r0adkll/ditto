---
/**
 * One live demo, embedded from the wasm catalog at /catalog/?id=…
 *
 * Deliberately an iframe rather than an in-page Compose root: every Compose root holds its own
 * WebGL2 context, browsers cap those (~8 on Android) and Compose exposes no dispose API, so
 * per-demo canvases would break a long page. `loading="lazy"` keeps the ~4.6 MB runtime off the
 * initial load; the browser fetches it when the frame nears the viewport, and it is HTTP- and
 * V8-cached for every later demo in the session.
 */
interface Props {
  id: string;
  idiom?: 'android' | 'apple' | 'desktop';
  mode?: 'light' | 'dark' | 'system';
  height?: number;
  caption?: string;
}
const { id, idiom, mode, height = 260, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const params = new URLSearchParams({ id, ...(idiom ? { idiom } : {}), ...(mode ? { mode } : {}) });
---
<div>
  <iframe
    class="ditto-demo"
    loading="lazy"
    src={`${base}/catalog/?${params.toString()}`}
    title={caption ?? `${id} demo`}
    style={`height:${height}px`}
  ></iframe>
  {caption && <p class="ditto-demo-caption">{caption}</p>}
</div>
